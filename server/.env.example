
# Configuración del Servidor

PORT=3000
NODE_ENV=development


# Configuración de Base de Datos (PostgreSQL)

# Opción 1: Credenciales separadas
DB_HOST=localhost
DB_PORT=5432
DB_USER=tu_usuario_local
DB_PASSWORD=tu_contraseña_local
DB_NAME=tienda_virtual_db

# Opción 2: URL de conexión (Muy común si usas ORMs como Prisma o Sequelize)
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/tienda_virtual_db?schema=public"

# Configuración de Autenticación (JWT)
JWT_SECRET=escribe_aqui_un_secreto_seguro_para_firmar_tokens
JWT_EXPIRES_IN=24h

# Configuración de CORS
FRONTEND_URL=http://localhost:5173